# 复制为 .env 使用(勿提交 .env, 含密钥)
# ================= 豆包/火山方舟 =================
# 账号控制台获取; 留空则界面模型配置里填
DOUBAO_API_KEY=

# ================= 运行环境 =================
# dev(开发) | prod(打包)
DRAMA_ENV=dev

# ================= 端口 =================
# 后端监听端口(开发/打包一致, 与常见 8000/3000 错开)
BACKEND_PORT=8031
# 前端 dev 端口(Next.js)
FRONTEND_PORT=3171

# ================= 数据目录(可选) =================
# 不设则 dev=项目根 data/, 打包=exe 旁 data/
# DRAMA_DATA_DIR=C:/path/to/data