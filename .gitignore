# --- Node ---
node_modules/

# --- Next 构建产物 ---
.next/
out/
# next-env.d.ts 由 Next 自动生成: next dev 写 .next/dev/types/、next build 写 .next/types/,
# 两者反复切换会产生无意义 diff(此前已为此单独提交过一次) → 不入库;
# 本地文件保留, 新克隆跑一次 dev/build 会自动生成(仅 TS 类型声明, 不影响构建与打包)
next/next-env.d.ts

# --- 打包产物 ---
release/
release-build/
release.zip
electron/dist/

# --- Electron 运行时缓存 ---
electron/next-server-build/

# --- 数据(数据库/上传/日志) ---
data/
*.db
*.db-wal
*.db-shm

# --- 密钥(local 略: .env 入库, .env.local 仅本机) ---
.env.local

# --- 工具/系统 ---
tsconfig.tsbuildinfo
dev-run.log
.DS_Store
Thumbs.db
__pycache__/
*.pyc
# --- pi 本地配置 ---
.pi/
# 密钥: .env 本地保留, 不入库(.env.example 示例入库)
.env
.codebase-memory/
