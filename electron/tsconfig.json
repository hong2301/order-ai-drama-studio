{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Nodenext",
    "moduleResolution": "Nodenext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": ["main.ts"]
}