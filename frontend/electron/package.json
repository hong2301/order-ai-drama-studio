{
  "name": "ai-video-studio-electron",
  "version": "0.1.0",
  "author": {
    "name": "ai-video-studio"
  },
  "main": "main.js",
  "scripts": {
    "dev": "concurrently -k -n next,electron -c blue,green \"npm run dev:next\" \"npm run dev:wait\"",
    "dev:next": "npm --prefix ../next run dev",
    "dev:wait": "wait-on http://127.0.0.1:3171 && electron .",
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "concurrently": "^10.0.5",
    "electron": "31.7.7",
    "electron-builder": "^26.15.3",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.ai.videostudio",
    "productName": "AI短剧工坊",
    "copyright": "Copyright © 2026",
    "directories": {
      "output": "../build"
    },
    "files": [
      "main.js",
      "icon.png",
      "out/**/*"
    ],
    "win": {
      "target": [
        "dir"
      ],
      "icon": "icon.ico",
      "executableName": "AiDramaStudio"
    },
    "electronVersion": "31.7.7"
  }
}